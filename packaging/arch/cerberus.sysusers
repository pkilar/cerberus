# Cerberus system user for the API service (installed to
# /usr/lib/sysusers.d/cerberus.conf; systemd-sysusers creates the user/group
# via pacman's hook on install/upgrade). The 'u' type creates both the group
# and the user; the home directory (/etc/cerberus) is shipped by the package.
#Type Name     ID GECOS             Home          Shell
u     cerberus -  "Cerberus SSH CA" /etc/cerberus /usr/bin/nologin
