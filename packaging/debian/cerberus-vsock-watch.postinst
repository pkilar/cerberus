#!/bin/sh
set -e

#DEBHELPER#

if [ "$1" = "configure" ] && [ -n "$2" ] && [ -d /run/systemd/system ]; then
    # On upgrade (old version = $2), apply the new binary by restarting the
    # service ONLY if the operator already has it running. Mirrors the RPM's
    # %systemd_postun_with_restart; a fresh install (unit stopped) is a no-op.
    deb-systemd-invoke try-restart cerberus-vsock-watch.service >/dev/null || true
fi
