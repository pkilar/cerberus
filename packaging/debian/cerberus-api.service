[Unit]
Description=Cerberus SSH Certificate API
Documentation=https://github.com/pkilar/cerberus
After=network-online.target nitro-enclaves-allocator.service
Wants=network-online.target
# Soft dependency (Wants=, not Requires=): the vsock-connect detective
# control (docs/vsock-connect-detection.md) is a separate, optional package.
# When it IS installed and enabled, cerberus-vsock-watch.service's
# Type=notify means "active" only once a detector has actually initialized
# (see that unit's own comment) -- so ordering After= it here closes the
# boot-time window where this service could start dialing the enclave before
# detection is watching. When cerberus-vsock-watch isn't installed at all,
# Wants=/After= on a nonexistent unit is a silent no-op and this service
# starts exactly as it does today.
After=cerberus-vsock-watch.service
Wants=cerberus-vsock-watch.service

[Service]
Type=simple
User=cerberus
Group=cerberus
# Dedicated slice, exclusive to this service -- NEVER add another service to
# it. The preventive LSM gate (cerberus-vsock-watch, opt-in --lsm-enforce)
# pins its cgroup-ancestry check against THIS slice's cgroup, which persists
# across this service's own restarts (only the service's own leaf cgroup is
# destroyed/recreated by systemd on Restart=on-failure). Sharing this slice
# with anything else would weaken that check back toward "any process in
# this slice" -- see docs/vsock-connect-detection.md §4.6.
Slice=cerberus-api.slice
EnvironmentFile=-/etc/default/cerberus-api
ExecStart=/usr/bin/ssh-cert-api
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/cerberus
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
