# ssh-cert-signer is a position-independent EXECUTABLE (built with
# -buildmode=pie), so it is ET_DYN and lintian misclassifies it as a shared
# library. It is a program, not a library: no SONAME, no library prerequisites.
cerberus-signer: shared-library-lacks-prerequisites [usr/bin/ssh-cert-signer]

# The service env file is shipped 0640 (not world-readable) on purpose, matching
# the RPM/Arch packaging; systemd reads the EnvironmentFile as root.
cerberus-signer: non-standard-file-perm 0640 != 0644 [etc/default/cerberus-signer]
